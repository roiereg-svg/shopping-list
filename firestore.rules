rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each list lives under a long random id that only the share link carries.
    // No rule lets anyone list the lists themselves.
    match /lists/{listId}/items/{itemId} {
      allow read, write: if request.auth != null && listId.size() >= 32;
    }
    match /lists/{listId}/meta/{docId} {
      allow read, write: if request.auth != null && listId.size() >= 32;
    }
  }
}
